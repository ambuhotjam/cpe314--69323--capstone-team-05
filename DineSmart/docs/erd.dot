digraph DineSmartERD {
graph [rankdir=LR, splines=polyline, overlap=false, nodesep=0.42, ranksep=1.0, pad=0.35, bgcolor="white", fontname="Arial", fontsize=18, labelloc="t", label="DineSmart — Finalized Entity-Relationship Diagram (16 tables)"];
node [shape=plain, fontname="Arial", fontsize=8];
edge [fontname="Arial", fontsize=8, color="#52677F", fontcolor="#34495E", arrowsize=0.7];
restaurant_tables [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>RESTAURANT_TABLES</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  table_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">UK</FONT>  table_label</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  capacity</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  active</TD></TR></TABLE>>];
staff_users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>STAFF_USERS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  staff_user_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">UK</FONT>  username</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  password_hash</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  password_salt</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  display_name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  role</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  active</TD></TR></TABLE>>];
menu_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>MENU_ITEMS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  menu_item_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">UK</FONT>  name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  item_type</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  price</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  price_cents</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  base_prep_minutes</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  api_meal_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  image_path</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  is_sold_out</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  available_today</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  daily_menu_date</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  is_archived</TD></TR></TABLE>>];
restaurant_orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>RESTAURANT_ORDERS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  order_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK</FONT>  table_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK</FONT>  created_by</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  ordered_at</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  status</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  payment_status</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  paid_at</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  service_status</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  served_at</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  customer_name</TD></TR></TABLE>>];
order_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>ORDER_ITEMS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  order_item_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK</FONT>  order_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK</FONT>  menu_item_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  quantity</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  unit_price_at_order</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  unit_price_cents</TD></TR></TABLE>>];
order_combo_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>ORDER_COMBO_ITEMS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  order_combo_item_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK</FONT>  order_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK</FONT>  combo_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  quantity</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  unit_price_at_order</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  unit_price_cents</TD></TR></TABLE>>];
ingredients [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>INGREDIENTS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  ingredient_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">UK</FONT>  name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  stock_quantity</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  stock_unit</TD></TR></TABLE>>];
menu_item_ingredients [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>MENU_ITEM_INGREDIENTS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK/FK</FONT>  menu_item_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK/FK</FONT>  ingredient_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  quantity_required</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  measure</TD></TR></TABLE>>];
menu_periods [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>MENU_PERIODS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  period_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK</FONT>  menu_item_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  period_name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  starts_on</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  ends_on</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  active</TD></TR></TABLE>>];
recipe_catalog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>RECIPE_CATALOG</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  recipe_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  source</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  external_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">UK</FONT>  name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  category</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  area</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  instructions</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  thumbnail_url</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  ingredients_text</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  created_at</TD></TR></TABLE>>];
recipe_ingredients [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>RECIPE_INGREDIENTS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK/FK</FONT>  recipe_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  ingredient_name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  source_measure</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  quantity</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  unit</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  parse_status</TD></TR></TABLE>>];
table_reservations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>TABLE_RESERVATIONS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  reservation_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK</FONT>  table_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  guest_name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  guest_phone</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  party_size</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  reservation_at</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  table_label</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  notes</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  status</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  created_at</TD></TR></TABLE>>];
menu_recommendations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>MENU_RECOMMENDATIONS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  recommendation_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  suggested_item</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  reason</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  suggested_by</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  status</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  created_at</TD></TR></TABLE>>];
ingredient_movements [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>INGREDIENT_MOVEMENTS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  movement_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK</FONT>  ingredient_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK</FONT>  order_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  quantity_change</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  reason</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  created_at</TD></TR></TABLE>>];
combos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>COMBOS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  combo_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">UK</FONT>  name</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  discount_percent</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  discount_basis_points</TD></TR></TABLE>>];
combo_components [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#60758D"><TR><TD BGCOLOR="#DCE7F5" ALIGN="LEFT"><B>COMBO_COMPONENTS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">PK</FONT>  component_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK</FONT>  combo_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK?</FONT>  menu_item_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#52647A">FK?</FONT>  child_combo_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF">--</FONT>  quantity</TD></TR></TABLE>>];
restaurant_tables -> restaurant_orders [label="1 : 0..*  optional table"];
staff_users -> restaurant_orders [label="1 : 0..*  optional creator"];
restaurant_tables -> table_reservations [label="1 : 0..*  optional table"];
restaurant_orders -> order_items [label="1 : many"];
menu_items -> order_items [label="1 : many"];
restaurant_orders -> order_combo_items [label="1 : many"];
combos -> order_combo_items [label="1 : many"];
menu_items -> menu_item_ingredients [label="1 : many"];
ingredients -> menu_item_ingredients [label="1 : many"];
menu_items -> menu_periods [label="1 : many"];
recipe_catalog -> recipe_ingredients [label="1 : many"];
ingredients -> ingredient_movements [label="1 : many"];
restaurant_orders -> ingredient_movements [label="1 : 0..*  optional order"];
combos -> combo_components [label="1 : many"];
menu_items -> combo_components [label="1 : 0..*  optional component"];
combos -> combo_components [label="parent combo / optional child combo"];
}